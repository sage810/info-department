{
  "$description": "정보부 업무 관리 웹앱의 디자인 토큰. 기준은 src/styles.css 의 :root 이고 design-tokens.css 와 같은 값이다. JS·Figma·다른 도구에서 읽을 때 쓴다. 값을 바꿀 때는 styles.css 를 먼저 고치고 여기에 다시 옮긴다. (마지막 정리: 2026-10-06)",
  "color": {
    "brand": {
      "purple": "#7132f5",
      "purpleDark": "#5741d8",
      "purpleDeep": "#4533b5",
      "purpleTint": "rgba(133,91,251,0.12)",
      "purpleTintStrong": "rgba(133,91,251,0.20)"
    },
    "text": {
      "ink": "#101114",
      "inkSoft": "#686b82",
      "inkFaint": "#727589"
    },
    "surface": {
      "bg": "#f7f7fb",
      "surface": "#ffffff",
      "surfaceAlt": "#fafafc",
      "surfaceHover": "#fbfaff",
      "neutralFill": "#f1f1f6",
      "border": "#dedee5",
      "borderControl": "#8f8fa0"
    },
    "status": {
      "green": "#149e61",
      "greenInk": "#0b6b41",
      "greenTint": "rgba(20,158,97,0.14)",
      "red": "#c62f42",
      "redDark": "#a02033",
      "redTint": "rgba(198,47,66,0.10)"
    },
    "topbar": {
      "bg": "#101114",
      "text": "#ffffff",
      "textDim": "rgba(255,255,255,0.60)",
      "line": "rgba(255,255,255,0.40)"
    },
    "sheetArea": {
      "school": "#4285F4",
      "goedu": "#12B5CB",
      "class": "#34A853",
      "device": "#FA7B17",
      "ops": "#A142F4",
      "other": "#9AA0A6"
    }
  },
  "typography": {
    "fontFamily": "'Pretendard', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "fontCdn": "https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css",
    "fontSize": {
      "xs": "12px", "sm": "12.5px", "md": "13.5px", "base": "14px",
      "lg": "16px", "xl": "19px", "2xl": "22px", "total": "34px"
    },
    "fontWeightUsed": [400, 500, 600, 700, 800],
    "lineHeight": { "tight": 1.3, "body": 1.5 },
    "letterSpacingTitle": "-0.3px"
  },
  "radius": { "sm": "6px", "control": "10px", "md": "12px", "lg": "20px", "pill": "999px" },
  "shadow": {
    "card": "0 4px 24px rgba(16,17,20,0.06)",
    "focusRing": "0 0 0 2px #ffffff, 0 0 0 4px #101114"
  },
  "size": {
    "touchMin": "44px",
    "touchMinSmallButton": "32px",
    "contentMax": "980px",
    "topbarStripHeight": "32px",
    "topbarCardHeight": "68px",
    "topbarHeight": "100px"
  },
  "motion": { "fast": "0.15s", "base": "0.35s" },
  "breakpoints": {
    "navCollapse": "max-width 1000px (메뉴를 햄버거 버튼 뒤로 접음)",
    "tableToolsStack": "max-width 720px (표 위 도구줄이 세로로 쌓임)",
    "mobile": "max-width 640px (min-width 641px 은 데스크톱 전용 규칙)",
    "stripNarrow": "max-width 520px (상단 띠의 '구글 시트' 글자 숨김, 아이콘만)"
  },
  "components": {
    "linkChip": {
      "description": "홈의 시트·업무 관리 사이트 바로가기 알약. 영역 색 --c 를 바탕·테두리에만 쓰고 글자는 늘 ink.",
      "height": "40px (모바일 44px)",
      "background": "color-mix(--c 10%, #fff)",
      "border": "color-mix(--c 35%, #fff)",
      "hover": { "background": "color-mix(--c 22%, #fff)", "border": "--c" }
    },
    "button": {
      "primary": "배경 purple, hover purpleDark, 누를 때 purpleDeep",
      "secondary": "흰 배경 + borderControl 테두리, hover 시 purple 테두리",
      "danger": "흰 배경 + red 테두리 + redDark 글자",
      "border": "1.5px",
      "disabledOpacity": 0.45
    }
  },
  "rules": [
    "포인트 색은 보라(#7132f5) 하나. 성공=초록, 오류·삭제=빨강.",
    "초록 틴트 위의 글자는 --green 이 아니라 --green-ink.",
    "안내 문구(placeholder)는 --ink-faint, 보조 글자는 --ink-soft.",
    "입력칸·선택 상자·보조 버튼의 경계는 --border-ctl(흰색 대비 3:1 이상), 카드·표의 구분선은 --border.",
    "버튼·메뉴 터치 영역은 44px 이상(작은 버튼만 32px).",
    "키보드 초점은 --focus-ring(흰 2px + 먹색 2px)으로 통일한다.",
    "최소 글자 크기 12px."
  ]
}
