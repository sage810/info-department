# ---- 프론트엔드 (Vite) ----
# 두 값이 비어 있으면 앱은 "데모 모드"로 동작한다 (src/data/demo.js 데이터 + localStorage 세션).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Netlify Functions (시트 동기화) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 구글 시트 파일 ID (URL의 /d/{ID}/ 부분)
GOOGLE_SHEET_ID=
# 서비스 계정 JSON 파일 내용을 한 줄로 (client_email, private_key 포함). 시트를 이 계정 이메일에 공유해야 한다.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- 시트 안전장치 스크립트 (scripts/setup-sheet-guards.mjs 전용, Netlify에는 필요 없음) ----
# 쉼표로 구분한 이메일. 적으면 이 사람들과 서비스 계정만 시트의 머리글·ID 열을 고칠 수 있게 잠그고, 비워 두면 경고만 띄운다.
SHEET_ADMIN_EMAILS=
